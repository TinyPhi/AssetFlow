#
# Names used in .env.local (LOCAL DEVELOPMENT ONLY; git-ignored). Do not copy this file by hand:
# scripts/bootstrap.sh (Windows: setup.bat) creates .env.local, generates the secrets once and
# writes the Zitadel results. Production keeps all of these in OpenBao (docs/operations/zitadel.md).

# ---- Public URLs (optional overrides; defaults shown)
# ZITADEL_DOMAIN=localhost
# ZITADEL_EXTERNALPORT=19081
# APP_URL=http://localhost:5173
# API_URL=http://localhost:18080

# ---- Generated once by `bootstrap_zitadel.py init-env` (never change the masterkey later)
ZITADEL_MASTERKEY=
ZITADEL_ADMIN_PASSWORD=
ZITADEL_DB_PASSWORD=
ZITADEL_DB_USER_PASSWORD=

# ---- Written by the Zitadel bootstrap (scripts/bootstrap_zitadel.py)
ZITADEL_URL=
ZITADEL_ISSUER=
# Project id = token audience (scope urn:zitadel:iam:org:project:id:{id}:aud)
ZITADEL_PROJECT_ID=
ZITADEL_WEB_CLIENT_ID=
ZITADEL_BFF_CLIENT_ID=
ZITADEL_BFF_CLIENT_SECRET=
ZITADEL_INTROSPECTION_CLIENT_ID=
ZITADEL_INTROSPECTION_CLIENT_SECRET=
# base64 of the JSON key of the assetflow-automation machine user (runtime Management API)
ZITADEL_SERVICE_ACCOUNT_KEY=
# base64 of the JSON key of the first-instance machine user (used by the bootstrap only)
ZITADEL_BOOTSTRAP_KEY=
# <slug>:<Zitadel organization id>,... = organizations.idp_organization_id per organization
ZITADEL_ORGANIZATIONS=
