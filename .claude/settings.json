{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git worktree*)",
      "Bash(git stash*)",
      "Bash(make verify*)",
      "Bash(make lint*)",
      "Bash(make typecheck*)",
      "Bash(make test*)",
      "Bash(make fmt*)",
      "Bash(make migrate*)",
      "Bash(make migration *)",
      "Bash(make config-validate*)",
      "Bash(make docs-check*)",
      "Bash(make up-minimal*)",
      "Bash(make down*)",
      "Bash(make logs*)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(python .claude/hooks/af.py*)",
      "Bash(python3 .claude/hooks/af.py*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh issue view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git merge*)",
      "Bash(gh pr merge*)",
      "Bash(make reset*)",
      "Bash(python .claude/hooks/af.py plan approve*)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production*)",
      "Read(**/.secrets/**)",
      "Write(**/.env)",
      "Write(**/.env.local*)",
      "Write(**/.env.production*)",
      "Write(**/.env.staging*)",
      "Write(**/.env.development*)",
      "Write(**/.secrets/**)",
      "Write(.git/**)",
      "Write(.claude/state/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" session_start.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" approval_gate.py" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" destructive_guard.py" },
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" commit_gate.py" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" protected_paths.py" },
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" edit_gate.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" post_edit_lint.py" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" ship_cleanup.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" verify_stop.py" }
        ]
      }
    ]
  }
}
