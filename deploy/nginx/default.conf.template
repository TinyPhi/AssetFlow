# AssetFlow Web & Hardened Reverse Proxy Template (§B13.1, §C5.10)

server {
    listen 8080;
    server_name ${ASSETFLOW_PUBLIC_HOST};

    root /usr/share/nginx/html;
    index index.html;

    # §C5.10 Security headers: the policy is set here, every header is added by the include that
    # each location below repeats (nginx does not inherit add_header into a location that has its own).
    set $csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ${ASSETFLOW_IDP_ORIGIN} ${ASSETFLOW_OTEL_BROWSER_ENDPOINT}; frame-ancestors 'none'; base-uri 'none'; form-action 'self' ${ASSETFLOW_IDP_ORIGIN}";

    # Auth & public config with strict auth rate limits (10r/m)
    location ~ ^/api/(auth/|config/public) {
        include /etc/nginx/snippets/security-headers.conf;
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;  # nosemgrep
        proxy_set_header X-Real-IP $remote_addr;
        # The edge proxy: never append a client-supplied X-Forwarded-For (AF-014); the API takes the
        # rightmost untrusted hop from this single value.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # General Backend API proxy
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://api:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;  # nosemgrep
        proxy_set_header X-Real-IP $remote_addr;
        # The edge proxy: never append a client-supplied X-Forwarded-For (AF-014); the API takes the
        # rightmost untrusted hop from this single value.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location /healthz {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass http://api:8080/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;  # nosemgrep
    }

    # Future public scan & report rate limiting placeholder
    # location /api/v1/public/scan {
    #     limit_req zone=public_scan burst=5 nodelay;
    #     proxy_pass http://api:8080;
    # }

    # SPA routing fallback
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(?:css|js|woff2?|svg|png|jpg|ico)$ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
